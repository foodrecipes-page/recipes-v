  "meal": "lunch",
  "ingredients": [
    {
      "name": "1 medium pumpkin (about 1 kg)",
      "amount": "1",
      "notes": "any variety, such as kabocha or butternut"
    },
    {
      "name": "1 onion",
      "amount": "1",
      "notes": "chopped"
    },
    {
      "name": "2 cloves garlic",
      "amount": "2",
      "notes": "minced"
    },
    {
      "name": "1 tablespoon ghee or vegetable oil",
      "amount": "1",
      "notes": "for cooking"
    },
    {
      "name": "1 teaspoon ground cumin",
      "amount": "1",
      "notes": "warm and earthy"
    },
    {
      "name": "1 teaspoon ground coriander",
      "amount": "1",
      "notes": "warm and citrusy"
    },
    {
      "name": "1/2 teaspoon ground cinnamon",
      "amount": "1/2",
      "notes": "warm and sweet"
    },
    {
      "name": "1/4 teaspoon cayenne pepper",
      "amount": "1/4",
      "notes": "optional, for some heat"
    },
    {
      "name": "1/4 cup chopped fresh parsley",
      "amount": "1/4",
      "notes": "for garnish"
    },
    {
      "name": "2 tablespoons bonito flakes",
      "amount": "2",
      "notes": "crispy and savory"
    },
    {
      "name": "Salt and pepper to taste",
      "amount": "",
      "notes": ""
    }
  ],
  "instructions": [
    "Heat the ghee or vegetable oil in the bottom of the tagine or a large saucepan over medium heat.",
    "Add the chopped onion and sauté until softened, about 5 minutes.",
    "Add the minced garlic and cook for another minute, until fragrant.",
    "Add the chopped pumpkin, cumin, coriander, cinnamon, and cayenne pepper (if using). Cook for 5 minutes, stirring occasionally.",
    "Add 2 cups of water to the tagine or saucepan and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 30 minutes, or until the pumpkin is tender.",
    "Stir in the bonito flakes and cook for another minute.",
    "Season with salt and pepper to taste.",
    "Garnish with chopped parsley and serve hot."
  ],
