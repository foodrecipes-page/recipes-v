{
  "title": "Vibrant Spicy Saudi-Arabian Pumpkin Tagine",
  "description": "A hearty and flavorful saudi-arabian dish featuring roasted pumpkin, crispy bonito flakes, and a blend of warming spices. Perfect for a comforting dinner or lunch.",
  "cuisine": "saudi-arabian",
  "diet": [
    "gluten-free"
