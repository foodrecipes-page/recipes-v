      "amount": "4 medium",
      "notes": "preferably vine-ripened"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "bonito flakes",
      "amount": "1/4 cup"
    },
    {
      "name": "whole wheat bread",
      "amount": "1 loaf"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "apple cider vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Slice the whole wheat bread into 1-inch thick slices and toast until lightly browned.",
    "Butter each slice of toasted bread.",
    "Mince the garlic cloves and sprinkle over the buttered bread.",
    "Slice the tomatoes into 1/2-inch thick slices and place on top of the garlic.",
    "Sprinkle bonito flakes over the tomatoes.",
    "Drizzle apple cider vinegar over the bonito flakes.",
    "Season with salt and black pepper to taste.",
    "Serve immediately and enjoy."
  ],
