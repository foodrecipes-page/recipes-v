      "name": "pea-eggplant",
      "amount": "2 medium",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "brine",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "norwegian cheese",
      "amount": "1/2 cup",
      "notes": "crumbled"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the brine in a large bamboo tray over medium heat.",
    "Add the chopped onion and cook until translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the pea-eggplant, carrots, and potatoes, and cook for 10 minutes.",
    "Stir in the crumbled norwegian cheese until melted.",
    "Season with salt and pepper to taste.",
    "Garnish with chopped fresh parsley and serve hot.",
    "Serve in the bamboo tray for a rustic presentation."
  ],
