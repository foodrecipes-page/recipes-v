  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "kabse spice",
      "amount": "2 tablespoons"
    },
    {
      "name": "brine-dry mustard",
      "amount": "1 teaspoon"
    },
    {
      "name": "malt syrup",
      "amount": "1/4 cup"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and cubed"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat.",
    "Add the lamb cubes and cook until browned on all sides.",
    "Add the kabse spice, brine-dry mustard, and malt syrup, and cook for 1 minute.",
    "Add the beef broth, carrots, potatoes, onion, and garlic, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 2.5 hours.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with fresh herbs if desired."
  ],
