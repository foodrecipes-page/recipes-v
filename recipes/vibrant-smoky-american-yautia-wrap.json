{
  "title": "Vibrant Smoky American Yautia Wrap",
  "description": "A smoky and creamy American dish featuring yautia, wrapped in a pandan leaf wrap, perfect for a lunch or snack",
  "cuisine": "American",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
