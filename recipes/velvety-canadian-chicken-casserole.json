{
  "title": "Velvety Canadian Chicken Casserole",
  "description": "A peppery and velvety Canadian dish featuring garlic sauce, this casserole is perfect for a weeknight dinner, and is halal-friendly.",
  "cuisine": "Canadian",
  "diet": [
    "halal"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "garlic sauce",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "bechamel sauce",
      "amount": "2 cups",
      "notes": "mother-sauce-base"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "freshly ground"
    },
    {
      "name": "paprika",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cheddar cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "pasta",
      "amount": "8 oz",
      "notes": "penne or rotini"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Cook the pasta according to package instructions until al dente.",
    "In a large skillet, saute the chicken, onion, and mushrooms in a little bit of oil until the chicken is cooked through.",
    "Add the garlic sauce, bechamel sauce, black pepper, paprika, and salt to the skillet and stir to combine.",
    "In a large bowl, combine the cooked pasta, chicken and sauce mixture, and stir until the pasta is well coated.",
    "Transfer the pasta mixture to a 9x13 inch baking dish and top with the shredded cheddar cheese.",
    "Bake in the preheated oven for 25-30 minutes, or until the cheese is melted and bubbly.",
    "Remove from the oven and let cool for a few minutes before serving.",
    "Serve hot and enjoy."
  ],
