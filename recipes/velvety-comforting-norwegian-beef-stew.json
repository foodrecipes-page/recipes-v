  "ingredients": [
    {
      "name": "beef stock",
      "amount": "4 cups",
      "notes": "low-sodium"
    },
    {
      "name": "rest-meat",
      "amount": "1.5 pounds",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "onions",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the beef stock in a large pot over medium heat.",
    "Add the rest-meat to the pot and cook until browned on all sides.",
    "Add the sliced carrots, cubed potatoes, and chopped onions to the pot.",
    "Pour in the lemon juice and stir to combine.",
    "Season the stew with black pepper and salt.",
    "Bring the stew to a boil, then reduce the heat to low and simmer for 1.5 hours.",
    "Stir in the chopped fresh parsley.",
    "Serve the stew hot, garnished with additional parsley if desired."
  ],
