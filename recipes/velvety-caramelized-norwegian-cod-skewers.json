{
  "title": "Velvety Caramelized Norwegian Cod Skewers",
  "description": "A pescatarian-friendly Norwegian dish featuring fatty and bouncy cod, caramelized to perfection with Appleton rum, served on a colorful Talavera plate.",
  "cuisine": "Norwegian",
  "diet": [
    "pescatarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Norwegian cod",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "Appleton rum",
      "amount": "1/4 cup"
    },
    {
      "name": "brown sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together Appleton rum, brown sugar, soy sauce, olive oil, garlic, ginger, salt, and black pepper.",
    "Add the cod pieces to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated cod onto skewers, leaving a small space between each piece.",
    "Grill the skewers for 8-10 minutes, turning occasionally, until the cod is cooked through and caramelized.",
    "Brush the skewers with lemon juice during the last minute of grilling.",
    "Serve the skewers on a Talavera plate, garnished with fresh herbs if desired.",
    "Let the skewers rest for 2-3 minutes before serving.",
    "Serve immediately and enjoy."
  ],
