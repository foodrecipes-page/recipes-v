      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lotus leaf wraps",
      "amount": "2",
      "notes": "fresh or dried"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium high heat.",
    "Add the chicken to the skillet and cook until browned, about 5 minutes.",
    "Add the garlic and ginger to the skillet and cook for 1 minute.",
    "Add the cumin, paprika, and salt to the skillet and cook for 1 minute.",
    "Stir in the sweetened condensed milk and lemon juice.",
    "Reduce heat to low and simmer the mixture for 5 minutes.",
    "Warm the lotus leaf wraps by wrapping them in a damp paper towel and microwaving for 20 seconds.",
    "Assemble the stir fry in the lotus leaf wraps and serve immediately."
  ],
