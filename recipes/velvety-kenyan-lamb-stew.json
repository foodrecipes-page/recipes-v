{
  "title": "Velvety Kenyan Lamb Stew",
  "description": "A fatty and fluffy weeknight Kenyan dish featuring pepper, this stew is perfect for a comforting meal, and its ingredients are Buddhist-temple-friendly.",
  "cuisine": "Kenyan",
  "diet": [
    "non-vegetarian"
