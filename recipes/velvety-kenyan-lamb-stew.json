      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon",
      "notes": "freshly ground"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "lamb broth",
      "amount": "2 cups",
      "notes": "low sodium"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup",
      "notes": "full fat"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    }
  ],
  "instructions": [
    "Heat oil in an earthenware bowl over medium heat.",
    "Add the lamb pieces and cook until browned on all sides.",
    "Add the onion, garlic, and ginger, and cook until the onion is translucent.",
    "Stir in the black pepper, cumin, and coriander, and cook for 1 minute.",
    "Add the lamb broth and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Stir in the coconut milk and cook for an additional 30 minutes.",
    "Season with salt to taste.",
    "Serve hot, garnished with chopped fresh cilantro if desired."
  ],
