  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat",
    "Add the chopped onions and cook until they are softened and translucent",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the cumin, coriander, paprika, salt, and black pepper, and cook for 1 minute",
    "Add the green peppers and cook until they start to soften",
    "Reduce the heat to low and simmer, covered, for 20 minutes",
    "Stir in the lemon juice and continue to simmer for another 10 minutes",
    "Serve the tagine in scallop shells and garnish with fresh parsley or cilantro"
  ],
