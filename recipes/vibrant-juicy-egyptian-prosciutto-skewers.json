  "ingredients": [
    {
      "name": "prosciutto",
      "amount": "12 slices",
      "notes": "thinly sliced"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "infused oil",
      "amount": "1/4 cup"
    },
    {
      "name": "pomegranate seeds",
      "amount": "1 cup"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "sumac",
      "amount": "1 tablespoon"
    },
    {
      "name": "wooden skewers",
      "amount": "12"
    },
    {
      "name": "salt",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together lemon juice, infused oil, garlic, and sumac.",
    "Add the prosciutto slices to the bowl and marinate for 10 minutes.",
    "Thread a piece of prosciutto, a few pomegranate seeds, and a sprinkle of parsley onto each wooden skewer.",
    "Season with salt to taste.",
    "Grill the skewers for 2-3 minutes per side, or until the prosciutto is crispy.",
    "Serve immediately on a wooden board.",
    "Garnish with additional parsley and pomegranate seeds if desired."
  ],
