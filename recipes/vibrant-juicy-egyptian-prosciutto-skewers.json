{
  "title": "Vibrant Juicy Egyptian Prosciutto Skewers",
  "description": "A sour and juicy Egyptian dish featuring prosciutto, infused oil, and sugar-free friendly ingredients, served on a wooden board.",
  "cuisine": "Egyptian",
  "diet": [
    "sugar-free",
    "low-carb"
  ],
