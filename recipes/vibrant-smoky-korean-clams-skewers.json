{
  "title": "Vibrant Smoky Korean Clams Skewers",
  "description": "Savory and snappy Korean dish featuring clams, perfect for a monsoon evening, made with a robata grill and dairy-free friendly ingredients.",
  "cuisine": "Korean",
  "diet": [
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "clams",
      "amount": "1 pound",
      "notes": "freshly shucked"
    },
    {
      "name": "gochujang",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the robata grill to medium high heat.",
    "In a large bowl, whisk together gochujang, soy sauce, brown sugar, garlic, and ginger.",
    "Add the clams to the bowl and toss to coat with the marinade.",
    "Thread the marinated clams onto skewers, leaving a small space between each clam.",
    "Brush the skewers with sesame oil and season with salt and pepper.",
    "Grill the skewers for 2-3 minutes per side, or until the clams are cooked through.",
    "Garnish with green onions and serve immediately.",
    "Serve with a side of steamed rice or noodles for a filling dinner."
  ],
