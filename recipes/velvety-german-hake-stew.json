    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    }
  ],
  "instructions": [
    "Preheat the sous-vide machine to 130 degrees Fahrenheit.",
    "Season the hake fillets with salt and pepper.",
    "Place the hake fillets in a sous-vide bag with white wine, fish stock, onion, carrot, celery, and garlic.",
    "Seal the bag and cook for 30 minutes.",
    "Remove the bag from the sous-vide machine and carefully open it.",
    "Transfer the contents to a fondue pot and add lemon juice.",
    "Simmer the stew over low heat for 10 minutes.",
    "Stir in chopped parsley and serve hot.",
    "Serve with crusty bread or over mashed potatoes.",
    "Garnish with additional parsley if desired."
  ],
