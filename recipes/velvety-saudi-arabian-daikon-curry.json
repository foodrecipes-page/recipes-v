      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the oil in a kadhai over medium heat",
    "Add the onion and cook until it is translucent",
    "Add the garlic and ginger and cook for 1 minute",
    "Add the curry powder and cook for 1 minute",
    "Add the daikon and cook until it is tender",
    "Add the coconut milk and bring to a simmer",
    "Add the shrimp and cook until it is pink and fully cooked",
    "Season with salt and pepper to taste",
    "Serve hot over rice"
  ],
