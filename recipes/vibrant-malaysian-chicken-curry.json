{
  "title": "Vibrant Malaysian Chicken Curry",
  "description": "A funky and juicy Malaysian dish featuring tomato sauce, served in a dolsot stone bowl, perfect for a crowd, this dairy free friendly recipe is a must try",
  "cuisine": "Malaysian",
  "diet": [
    "dairy-free",
