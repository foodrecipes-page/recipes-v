  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite sized pieces"
    },
    {
      "name": "tomato sauce",
      "amount": "2 cups"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "binchotan charcoal smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat",
    "Add the chicken to the pan and cook until browned",
    "Add the curry powder and smoked paprika to the pan and cook for 1 minute",
    "Add the tomato sauce and coconut milk to the pan and stir to combine",
    "Bring the mixture to a simmer and cook until the chicken is cooked through",
    "Season the curry with salt and pepper to taste",
    "Transfer the curry to a dolsot stone bowl and serve hot"
  ],
