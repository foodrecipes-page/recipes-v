      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat oil in a large pan over medium heat and saute the onion until softened.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the curry powder and cayenne pepper and cook for 1 minute, stirring constantly.",
    "Add the chicken and cook until browned on all sides.",
    "Add the palm sugar, nam tan pip, and coconut milk, and stir to combine.",
    "Bring the mixture to a simmer and cook for 20 minutes, or until the chicken is cooked through.",
    "Season with salt to taste.",
    "Serve hot over rice or noodles."
  ],
