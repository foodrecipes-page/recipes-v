  "ingredients": [
    {
      "name": "beef strips",
      "amount": "1 pound",
      "notes": "flank steak or skirt steak"
    },
    {
      "name": "kombu",
      "amount": "2 sheets",
      "notes": "dried seaweed"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "carrot",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "diced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "cedar planks",
      "amount": "4",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, garlic, salt, and black pepper.",
    "Add the beef strips to the bowl and marinate for 30 minutes.",
    "Thread the marinated beef strips onto skewers, leaving a small space between each piece.",
    "Place the skewers on the preheated grill and cook for 5 minutes per side, or until charred.",
    "Meanwhile, combine diced onion, carrot, and celery in a bowl.",
    "Add the kombu sheets to the bowl and toss to combine.",
    "Place the cedar planks on the grill and top each plank with a beef skewer and a spoonful of the mirepoix mixture.",
    "Close the grill lid and cook for an additional 5 minutes, or until the plank is lightly charred."
  ],
