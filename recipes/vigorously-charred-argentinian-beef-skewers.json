{
  "title": "Vigorously Charred Argentinian Beef Skewers",
  "description": "A monsoon Argentinian dish featuring charred beef skewers with kombu and mirepoix-base, served on a cedar plank.",
  "cuisine": "Argentinian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
