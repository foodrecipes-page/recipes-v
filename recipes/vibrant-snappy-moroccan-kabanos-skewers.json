  "ingredients": [
    {
      "name": "kabanos sausage",
      "amount": "12 slices",
      "notes": "Polish sausage"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "infused with garlic and herbs"
    },
    {
      "name": "red bell pepper",
      "amount": "1 large",
      "notes": "diced"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "diced"
    },
    {
      "name": "malty syrup",
      "amount": "2 tbsp",
      "notes": "date syrup or honey"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "paprika",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp"
    }
  ],
  "instructions": [
    "Preheat the tava griddle to medium high heat.",
    "Thread kabanos slices, red bell pepper, and onion onto skewers.",
    "Brush the skewers with infused olive oil and season with paprika, salt, and black pepper.",
    "Cook the skewers for 10 minutes, turning occasionally.",
    "Brush the skewers with malty syrup during the last 2 minutes of cooking.",
    "Serve the skewers hot with a squeeze of lemon juice.",
    "Garnish with fresh parsley or cilantro if desired.",
    "Serve immediately and enjoy."
  ],
