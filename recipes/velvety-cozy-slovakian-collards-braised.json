      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped, caramelized for depth of flavor"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced, for aroma and pungency"
    },
    {
      "name": "spruce tips",
      "amount": "1 tablespoon",
      "notes": "fresh, for a resinous flavor"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for saut\u00185n and browning"
    },
    {
