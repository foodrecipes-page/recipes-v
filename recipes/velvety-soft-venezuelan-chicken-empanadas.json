{
  "title": "Venezuelan Chicken Empanadas",
  "description": "Soft and pillowy empanadas filled with chicken and served with chimichurri sauce and pickle, perfect for kids and adults alike.",
  "cuisine": "Venezuelan",
  "diet": [
    "kid-friendly"
  ],
