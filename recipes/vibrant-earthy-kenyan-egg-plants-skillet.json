      "name": "Egg plants",
      "amount": "2 medium",
      "notes": "sliced into 1/2 inch thick rounds"
    },
    {
      "name": "Coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "Tomato",
      "amount": "2 medium",
      "notes": "diced"
    },
    {
      "name": "Cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "Paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large skillet over medium heat",
    "Add the chopped onion and cook until it is translucent",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the sliced egg plants and cook for 5 minutes on each side",
    "Add the diced tomato, cumin, paprika, salt, and black pepper, and stir well",
    "Reduce the heat to low and simmer for 10 minutes",
    "Use a whisk to stir and scrape the bottom of the skillet",
    "Serve the skillet hot, garnished with fresh herbs if desired"
  ],
