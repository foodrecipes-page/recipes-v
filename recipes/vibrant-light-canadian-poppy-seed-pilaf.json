      "amount": "1/2 teaspoon"
    },
    {
      "name": "quinoa",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit",
    "In a large saucepan, heat the olive oil over medium heat",
    "Add the diced onions, carrots, and celery and cook until the vegetables are tender, about 8 minutes",
    "Add the toasted poppy seeds and cook for 1 minute, stirring constantly",
    "Add the quinoa, chicken broth, salt, and pepper, and bring to a boil",
    "Cover the saucepan with a tight-fitting lid and transfer to the preheated oven",
    "Bake for 20 minutes, or until the quinoa is tender and the liquid has been absorbed",
    "Remove the pilaf from the oven and let it cool for 5 minutes before serving"
  ],
