{
  "title": "Vibrant Slovakian Clam Casserole",
  "description": "A sour and crumbly Slovakian dish featuring clams and ferment kimchi, perfect for a weeknight dinner, dairy-free friendly and cooked on a salt block.",
  "cuisine": "Slovakian",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "clams",
      "amount": "1 pound",
      "notes": "freshly shucked"
    },
    {
      "name": "ferment kimchi",
      "amount": "1 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "salt block",
      "amount": "1 piece",
      "notes": "heated to 400 degrees"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "for brushing the salt block"
    },
    {
      "name": "gluten-free breadcrumbs",
      "amount": "1/2 cup",
      "notes": "for topping"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon",
      "notes": "for added flavor"
    },
    {
      "name": "onion powder",
      "amount": "1 teaspoon",
      "notes": "for added flavor"
    },
    {
      "name": "dairy-free milk",
      "amount": "1 cup",
      "notes": "for moisture"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon",
      "notes": "for color and flavor"
    }
  ],
  "instructions": [
    "Preheat the salt block to 400 degrees for 30 minutes before cooking.",
    "Brush the heated salt block with olive oil to prevent sticking.",
    "In a large bowl, mix together the clams, ferment kimchi, lemon juice, garlic powder, onion powder, and paprika.",
    "Pour the dairy-free milk into the bowl and stir until the mixture is well combined.",
    "Pour the clam mixture onto the preheated salt block and top with gluten-free breadcrumbs.",
    "Cook the casserole for 20 minutes or until the top is golden brown and the clams are cooked through.",
    "Remove the casserole from the salt block and let it cool for 5 minutes before serving.",
    "Serve the Vibrant Slovakian Clam Casserole hot, garnished with additional ferment kimchi if desired."
  ],
