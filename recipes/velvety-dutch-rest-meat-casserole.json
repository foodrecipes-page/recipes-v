{
  "title": "Velvety Dutch Rest-Meat Casserole",
  "description": "A comforting Dutch dish featuring rest-meat, cultured-creme-fraiche, and vegetables in a rich, velvety sauce.",
  "cuisine": "Dutch",
  "diet": [
    "gluten-free",
    "fodmap-friendly"
