  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "colby jack cheese",
      "amount": "1/2 cup",
      "notes": "shredded"
    },
    {
      "name": "garlic",
      "amount": "6 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "berbere spice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "scalloped shells",
      "amount": "4-6",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Season the chicken with salt, black pepper, and berbere spice.",
    "Heat the olive oil in a large skillet over medium-high heat and cook the chicken until browned.",
    "Add the onion and garlic to the skillet and cook until the onion is translucent.",
    "Add the chicken broth to the skillet and bring to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Stir in the shredded colby jack cheese until melted.",
    "Transfer the chicken mixture to the scalloped shells.",
    "Bake in the preheated oven for 15 minutes or until the cheese is golden brown."
  ],
