{
  "title": "Kenyan Spherified Cranberry Oat Bowl",
  "description": "A bitter and velvety Kenyan-inspired dish featuring cranberry juice and spherified ingredients, perfect for a vegetarian-friendly brunch.",
  "cuisine": "kenyan",
