      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pita bread",
      "amount": "4 slices",
      "notes": "for serving en-croute"
    }
  ],
  "instructions": [
    "Preheat the wok over medium heat",
    "Thread the zucchini, bell peppers, onions, and mushrooms onto skewers",
    "Brush the skewers with olive oil and season with salt and black pepper",
    "Cook the skewers in the wok for 10 minutes, turning occasionally",
    "Meanwhile, mix the tahini paste and lemon juice in a small bowl",
    "Brush the tahini mixture onto the skewers during the last 2 minutes of cooking",
    "Warm the pita bread by wrapping it in a damp paper towel and microwaving for 20 seconds",
    "Serve the skewers en-croute in the pita bread"
  ],
