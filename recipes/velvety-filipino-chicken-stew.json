{
  "title": "Velvety Filipino Chicken Stew",
  "description": "A salty and velvety Filipino dish featuring sultanas and render fat, perfect for a sick day, and dairy free friendly.",
  "cuisine": "Filipino",
  "diet": [
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "boneless and skinless"
    },
    {
      "name": "render fat or vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "sultanas",
      "amount": "1/2 cup"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "water",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the render fat or oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken thighs and cook until they are browned on all sides.",
    "Add the sultanas, fish sauce, soy sauce, black pepper, and salt, and stir to combine.",
    "Pour in the water and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 30 minutes.",
    "Remove the pot from the heat and let it cool slightly.",
    "Serve the stew hot, garnished with additional sultanas if desired."
  ],
