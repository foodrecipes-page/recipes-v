{
  "title": "Vegan Ukrainian Comte Skillet",
  "description": "A salty and tender weeknight Ukrainian dish featuring vegan Comte cheese, sauteed in a cast-iron skillet.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "vegan Comte cheese",
      "amount": "1 cup shredded",
      "notes": "available at health food stores"
    },
    {
      "name": "onions",
      "amount": "1 large chopped"
    },
    {
      "name": "mushrooms",
      "amount": "2 cups sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium peeled and grated"
    },
    {
      "name": "potatoes",
      "amount": "2 medium peeled and diced"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large cast-iron skillet over medium heat.",
    "Add the onions and saute until they are translucent.",
    "Add the mushrooms and garlic and saute until the mushrooms release their liquid and start to brown.",
    "Add the carrots and potatoes and saute for 5 minutes.",
    "Add the vegan Comte cheese and stir until it is well combined with the vegetables.",
    "Season with salt and pepper to taste.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Serve hot and enjoy."
  ],
